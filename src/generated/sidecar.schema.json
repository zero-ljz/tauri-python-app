{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sidecar.schema.json",
  "title": "Sidecar Schema Bundle",
  "$defs": {
    "RpcNotification": {
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "const": "2.0",
          "default": "2.0",
          "title": "Jsonrpc",
          "type": "string"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "params": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Params"
        }
      },
      "required": [
        "method"
      ],
      "title": "RpcNotification",
      "type": "object"
    },
    "SystemInfoResult": {
      "additionalProperties": false,
      "properties": {
        "ok": {
          "default": true,
          "title": "Ok",
          "type": "boolean"
        },
        "pid": {
          "title": "Pid",
          "type": "integer"
        },
        "python_version": {
          "title": "Python Version",
          "type": "string"
        },
        "platform": {
          "title": "Platform",
          "type": "string"
        }
      },
      "required": [
        "pid",
        "python_version",
        "platform"
      ],
      "title": "SystemInfoResult",
      "type": "object"
    },
    "AsyncSleepPayload": {
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "default": 4000,
          "maximum": 120000,
          "minimum": 100,
          "title": "Duration Ms",
          "type": "integer"
        },
        "steps": {
          "default": 8,
          "maximum": 100,
          "minimum": 1,
          "title": "Steps",
          "type": "integer"
        }
      },
      "title": "AsyncSleepPayload",
      "type": "object"
    },
    "BlockingIoPayload": {
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "default": 2500,
          "maximum": 120000,
          "minimum": 100,
          "title": "Duration Ms",
          "type": "integer"
        }
      },
      "title": "BlockingIoPayload",
      "type": "object"
    },
    "CpuCountPayload": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 75000,
          "maximum": 2000000,
          "minimum": 1000,
          "title": "Limit",
          "type": "integer"
        },
        "timeout_ms": {
          "default": 30000,
          "maximum": 600000,
          "minimum": 1000,
          "title": "Timeout Ms",
          "type": "integer"
        }
      },
      "title": "CpuCountPayload",
      "type": "object"
    },
    "TaskDescriptor": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "kind": {
          "enum": [
            "async_io",
            "blocking_io",
            "cpu_bound"
          ],
          "title": "Kind",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "default_payload": {
          "additionalProperties": true,
          "title": "Default Payload",
          "type": "object"
        }
      },
      "required": [
        "name",
        "title",
        "kind",
        "description",
        "default_payload"
      ],
      "title": "TaskDescriptor",
      "type": "object"
    },
    "TaskCatalogResult": {
      "additionalProperties": false,
      "properties": {
        "tasks": {
          "items": {
            "$ref": "#/$defs/TaskDescriptor"
          },
          "title": "Tasks",
          "type": "array"
        }
      },
      "required": [
        "tasks"
      ],
      "title": "TaskCatalogResult",
      "type": "object"
    },
    "TaskStartParams": {
      "additionalProperties": false,
      "properties": {
        "task_name": {
          "title": "Task Name",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        }
      },
      "required": [
        "task_name"
      ],
      "title": "TaskStartParams",
      "type": "object"
    },
    "TaskStartResult": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "task_name": {
          "title": "Task Name",
          "type": "string"
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "cancelling",
            "completed",
            "failed",
            "cancelled"
          ],
          "title": "State",
          "type": "string"
        },
        "accepted_at": {
          "title": "Accepted At",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "task_name",
        "state",
        "accepted_at"
      ],
      "title": "TaskStartResult",
      "type": "object"
    },
    "TaskCancelParams": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id"
      ],
      "title": "TaskCancelParams",
      "type": "object"
    },
    "TaskCancelResult": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "accepted": {
          "title": "Accepted",
          "type": "boolean"
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "cancelling",
            "completed",
            "failed",
            "cancelled"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "accepted",
        "state"
      ],
      "title": "TaskCancelResult",
      "type": "object"
    },
    "TaskStatusParams": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id"
      ],
      "title": "TaskStatusParams",
      "type": "object"
    },
    "TaskStatusResult": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "task_name": {
          "title": "Task Name",
          "type": "string"
        },
        "kind": {
          "enum": [
            "async_io",
            "blocking_io",
            "cpu_bound"
          ],
          "title": "Kind",
          "type": "string"
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "cancelling",
            "completed",
            "failed",
            "cancelled"
          ],
          "title": "State",
          "type": "string"
        },
        "progress": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Progress",
          "type": "number"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "result": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "started_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        }
      },
      "required": [
        "task_id",
        "task_name",
        "kind",
        "state",
        "progress"
      ],
      "title": "TaskStatusResult",
      "type": "object"
    }
  }
}
