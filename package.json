{
  "name": "tauri-python-app",
  "private": true,
  "version": "0.1.0",
  "description": "Production-oriented Tauri v2, React, Rust, and Python sidecar template",
  "author": "Template Authors",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen:protocol": "python scripts/gen_protocol.py",
    "gen:types": "python scripts/gen_types.py",
    "generate": "pnpm gen:protocol && pnpm gen:types",
    "build:backend": "pnpm gen:protocol && python scripts/build_backend.py",
    "typecheck": "tsc",
    "format:frontend": "biome format --write src vite.config.ts vitest.config.ts",
    "lint:frontend": "biome lint src vite.config.ts vitest.config.ts",
    "check:frontend": "biome check src vite.config.ts vitest.config.ts",
    "lint:python": "python -m ruff check backend scripts tests",
    "test:frontend": "vitest run",
    "test:python": "python -m unittest discover -s tests -v",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --all-features",
    "test": "pnpm test:frontend && pnpm test:python && pnpm test:rust",
    "check": "python scripts/check.py",
    "check:versions": "python scripts/sync_version.py --check",
    "build": "pnpm generate && pnpm typecheck && vite build",
    "build:release": "pnpm build:backend && pnpm build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build": "pnpm tauri build"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tauri-apps/api": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "mobx": "^7.0.0",
    "mobx-react-lite": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "pyright": "^1.1.411",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
