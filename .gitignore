# 日志记录
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 依赖与编译产物
node_modules
dist
dist-ssr
*.local
.vite

# 编译器与编辑器缓存
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── Python Sidecar 与打包缓存 ───────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.venv
venv
ENV/
env/

# PyInstaller 构建产物（build/ 为临时目录，bin/ 为打包后的二进制）
build/
src-tauri/bin/

# PyInstaller spec 文件（由 build_sidecar.py 在 build/pyinstaller/spec/ 内生成，
# 根目录若有残留 spec 也一并排除）
*.spec

# 自动生成的类型文件（由 gen_types.py 生成，不应手工编辑）
src/types/schema.json
